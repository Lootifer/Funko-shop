<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Afrekenen | Lootifer Collectibles</title>
    <link rel="stylesheet" href="Assets/Css/main.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div id="headerRoot"></div>

    <main class="checkout-page reveal">
      <section class="section-heading">
        <p class="eyebrow">Afrekenen</p>
        <h1>Plaats een orderaanvraag.</h1>
        <p class="hero-text">Online betaling is nog niet actief. Vul je gegevens in om een professionele testorder te versturen.</p>
      </section>

      <section class="checkout-layout">
        <article class="checkout-panel">
          <div class="checkout-notice">Dit is een orderaanvraag totdat er een betaalprovider is aangesloten. Er wordt nu nog geen echte betaling verwerkt.</div>
          <form class="checkout-form" id="checkoutForm" novalidate>
            <div class="checkout-form-grid">
              <label>
                Naam
                <input id="checkoutName" name="name" type="text" required />
              </label>
              <label>
                E-mail
                <input id="checkoutEmail" name="email" type="email" required />
              </label>
              <label>
                Telefoon
                <input id="checkoutPhone" name="phone" type="tel" required />
              </label>
              <label>
                Straat
                <input id="checkoutStreet" name="street" type="text" required />
              </label>
              <label>
                Huisnummer
                <input id="checkoutHouseNumber" name="houseNumber" type="text" required />
              </label>
              <label>
                Postcode
                <input id="checkoutPostalCode" name="postalCode" type="text" placeholder="1234 AB" required />
              </label>
              <label>
                Plaats
                <input id="checkoutCity" name="city" type="text" required />
              </label>
              <label>
                Land
                <input id="checkoutCountry" name="country" type="text" value="Nederland" required />
              </label>
              <label class="full-span">
                Leveringsmethode
                <select id="checkoutDeliveryMethod" name="deliveryMethod" required>
                  <option value="">Kies een leveringsmethode</option>
                  <option value="Standard">Standaard levering</option>
                  <option value="Express">Spoedlevering</option>
                  <option value="Pickup">Afhalen in de winkel</option>
                </select>
              </label>
              <label class="full-span">
                Opmerkingen bij de bestelling
                <textarea id="checkoutNotes" name="notes" placeholder="Bijvoorbeeld: bel aan bij de achteringang."></textarea>
              </label>
            </div>

            <div id="checkoutErrors" class="admin-error" style="display: none;"></div>
            <div class="checkout-actions">
              <button class="button primary" type="submit">Bestelling aanvragen</button>
              <a class="button secondary" href="cart.html">Terug naar winkelwagen</a>
            </div>
          </form>
        </article>

        <aside class="checkout-panel order-summary-card">
          <h2>Besteloverzicht</h2>
          <p class="order-summary-meta" id="checkoutMeta">0 artikelen</p>
          <div id="checkoutSummary"></div>
        </aside>
      </section>

      <section id="checkoutConfirmation" class="confirmation-panel" hidden></section>
    </main>

    <div id="footerRoot"></div>

    <script type="module" src="Assets/Js/checkout.js"></script>
  </body>
</html>